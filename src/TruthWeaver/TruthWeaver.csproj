<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>a19c0b9e-c1d5-4d3c-8e2f-7a9b6c5d4e3f</ProjectGuid>
    <RootNamespace>TruthWeaver</RootNamespace>
    <Description>
      TruthWeaver: the DSL parser, RuleCompiler, BDD-based analyzer, evaluator,
      System.Text.Json tree support, and dependency-injection registration extensions for
      the compile-once/evaluate-many boolean rule engine.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TruthWeaver.Abstractions/TruthWeaver.Abstractions.csproj" />
  </ItemGroup>

  <!-- Microsoft.Extensions.DependencyInjection.Abstractions and Microsoft.Extensions.Logging.Abstractions
       (ADR-0004's declared dependencies) ship in the net11.0 shared framework itself, so an explicit
       PackageReference is pruned/warned-about by the SDK; the dependency is still real; it's just
       satisfied by the shared framework rather than a NuGet package on this target framework. -->

  <!-- ADR-0003's JSON tree shape, published as a content asset so a consuming UI/tooling project can
       validate rule documents structurally without hand-copying the shape. Not embedded/loaded by any
       production code path here - the package only carries the file. -->
  <ItemGroup>
    <None Include="Json\rule-tree.schema.json" Pack="true" PackagePath="content\rule-tree.schema.json" Visible="true" />
  </ItemGroup>
</Project>
