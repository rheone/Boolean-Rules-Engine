root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
tab_width = 4

# Modern C#
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_using_directive_placement = inside_namespace:warning
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_system_threading_lock = true:suggestion

# Prefer explicit types by default; use var intentionally.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Qualification: this repo qualifies member access with "this." throughout (StyleCop's SA1101
# requires it), so the preference here is "true", not "false" - the previous "false" setting
# actively fought the codebase's own convention, flagging every correct "this." as IDE0003
# ("name can be simplified") and failing `dotnet format --verify-no-changes`.
dotnet_style_qualification_for_field = true:suggestion
dotnet_style_qualification_for_property = true:suggestion
dotnet_style_qualification_for_method = true:suggestion
dotnet_style_qualification_for_event = true:suggestion

# Accessibility
dotnet_style_require_accessibility_modifiers = always:warning

# Simplification
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

# Naming: private fields are plain camelCase, qualified with "this." (not an "_" prefix) throughout
# this codebase - a leftover "require an _ prefix" naming rule here would contradict every existing
# field in the repo, so none is configured; StyleCop's SA1309 already rejects underscore-prefixed
# fields by default, and the "this." qualification convention is enforced by SA1101 instead.

# Documentation: CSharpier/modern C# formatting takes precedence over
# legacy formatting rules where the two overlap.
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1633.severity = none

# SA1009/SA1111 ("closing parenthesis should not be preceded by a space" / "should be on the line of
# the last parameter") routinely conflict with CSharpier's own multi-line call-wrapping style, which
# places a closing ')' on its own indented line whenever an argument list must wrap. CSharpier is
# this repo's authoritative formatter (CLAUDE.md), so both are disabled rather than fought.
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1111.severity = none

# SA1500/SA1502 similarly conflict with CSharpier's canonical output for an empty block body
# ("{ }" collapsed onto one line, e.g. a private-protected base-class constructor) and for
# do/while's "} while (...)" sharing a line. Same rationale as above.
dotnet_diagnostic.SA1500.severity = none
dotnet_diagnostic.SA1502.severity = none

# IDE0028 ("collection initialization can be simplified") is disabled: applying its own code fix to
# a `new List<T>(capacity)` or `new HashSet<T>(comparer)` call - i.e. a constructor argument, not an
# initializer - corrupts the call into invalid syntax like `[with(capacity)]`. Confirmed reproducible
# against this exact Roslyn/SDK version (dotnet format 11.0.100-rc.1.26425.128) on every occurrence
# in this repo; verified by hand each time and always reverted. Do not run `dotnet format` in apply
# mode (only `--verify-no-changes`) until this is fixed upstream.
dotnet_diagnostic.IDE0028.severity = none

# CA1859 ("change return type for improved performance") is disabled for this repo's internal
# parser/serializer helper methods (e.g. RuleNode ParseTerm(...), JsonNode TermToNode(...)): they
# deliberately return the shared base/interface type because sibling methods in the same dispatch
# switch must return that same type, and CA1859's suggestion would only apply to a few of them
# without fighting that shared shape everywhere else.
dotnet_diagnostic.CA1859.severity = none

[*.csproj]
indent_size = 2

[*.props]
indent_size = 2

[*.targets]
indent_size = 2

[*.json]
indent_size = 2

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
