<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Roslynator. (Roslynator.CodeFixes/Roslynator.Refactorings are IDE-extension-only packages,
       not referenced by any PackageReference here, so they are deliberately not pinned.) -->
  <ItemGroup>
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.0" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.0" />
  </ItemGroup>
  <!-- StyleCop -->
  <ItemGroup>
    <!-- 1.2.0-beta is required for record support: 1.1.x SA1313 flags PascalCase positional-record
         parameters, which are correct (they become public properties). -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>
  <!-- SonarAnalyzer -->
  <ItemGroup>
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.34.0.3385" />
  </ItemGroup>
  <!-- Async/await usage analyzers -->
  <ItemGroup>
    <PackageVersion Include="AsyncFixer" Version="2.1.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
  </ItemGroup>
  <!-- IDisposable usage analyzer -->
  <ItemGroup>
    <PackageVersion Include="IDisposableAnalyzers" Version="4.0.8" />
  </ItemGroup>
  <!-- Microsoft extensions (ship with .NET 11). Abstractions packages are what TruthWeaver
       itself depends on (ADR-0004); the non-Abstractions packages are test-only, wiring a real DI
       container/logger in the DI-registration-extension tests (ticket 12). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>
  <!-- YamlDotNet - TruthWeaver.Yaml's sole dependency beyond TruthWeaver itself. -->
  <ItemGroup>
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <!-- xUnit v3 + MTP test packages -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.4.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- coverlet.MTP, not coverlet.collector (a VSTest data collector, which the
         UseMicrosoftTestingPlatformRunner test host below cannot load), is the native
         Microsoft.Testing.Platform coverage extension; run via the "coverlet" CLI flag
         documented at https://github.com/coverlet-coverage/coverlet. -->
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
  </ItemGroup>
  <!-- NSubstitute -->
  <ItemGroup>
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
  </ItemGroup>
  <!-- JsonSchema.Net - test-project-only, to validate rule-tree.schema.json against the compiler's own
       JSON fixtures (ticket: JSON Schema for the rule tree). Not referenced by any shipping project;
       the schema itself is packaged as a plain content file, not consumed by production code. -->
  <ItemGroup>
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>
  <!-- CsCheck - test-project-only, property-based/generative testing for the DSL printer/parser
       round-trip (ticket: DSL round-trip property testing). Chosen over FsCheck: pure C# (no F#
       runtime dependency to pull into a C#-only repo), PCG-based generation and shrinking that is
       fast and fully automatic (no hand-written Arbitrary/shrink instances), and every failure
       reports a replayable seed. Not referenced by any shipping project. -->
  <ItemGroup>
    <PackageVersion Include="CsCheck" Version="4.9.1" />
  </ItemGroup>
  <!-- Source Link -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100-rc.1.26425.128" />
  </ItemGroup>
  <!-- NetArchTest - architecture-test-project-only, asserting the ADR-0004 package-boundary rules
       (e.g. TruthWeaver.Abstractions has zero dependencies on the other TruthWeaver.* assemblies,
       TruthWeaver.Predicates/Testing depend on Abstractions alone) as a build-time check rather than
       something only a code reviewer notices. Not referenced by any shipping project. -->
  <ItemGroup>
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
  <!-- BenchmarkDotNet - benchmarks-project-only (ticket: BenchmarkDotNet suite for compile and eval
       performance). Never referenced by src/ or shipped in any package; the benchmarks project is a
       throwaway console app that measures RuleCompiler/CompiledRule performance from outside the
       library. -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
